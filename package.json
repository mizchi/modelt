{
  "name": "@mizchi/modelt",
  "version": "0.0.0",
  "private": true,
  "description": "Portable model oracles, conformance and property testing for TypeScript",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./portable": {
      "types": "./dist/src/portable.d.ts",
      "default": "./dist/src/portable.js"
    },
    "./budget": {
      "types": "./dist/src/budget.d.ts",
      "default": "./dist/src/budget.js"
    },
    "./sharding": {
      "types": "./dist/src/sharding.d.ts",
      "default": "./dist/src/sharding.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./property": {
      "types": "./dist/src/property.d.ts",
      "default": "./dist/src/property.js"
    },
    "./tla": {
      "types": "./dist/src/tla.d.ts",
      "default": "./dist/src/tla.js"
    },
    "./smt": {
      "types": "./dist/src/smt.d.ts",
      "default": "./dist/src/smt.js"
    }
  },
  "scripts": {
    "portable:build": "cargo build --release --locked --manifest-path crates/modelt-core/Cargo.toml && cargo build --release --locked --lib --target wasm32-unknown-unknown --manifest-path crates/modelt-core/Cargo.toml",
    "portable:test": "pnpm build && cargo test --all-targets --locked --manifest-path crates/modelt-core/Cargo.toml && node --test dist/evals/portable/contract-test.js",
    "portable:browser": "playwright test --config portable-playwright.config.ts",
    "portable:eval": "pnpm build && node dist/evals/portable/evaluate.js",
    "portable:replay": "pnpm build && node dist/evals/portable/replay.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "test": "pnpm test:vitest && pnpm test:node",
    "test:vitest": "vitest run",
    "test:node": "pnpm build && node --test dist/tests/node.test.js",
    "test:browser": "playwright test",
    "test:mutation": "mutator --runner vitest --config vitest.mutation.config.ts --reporter text --reporter json",
    "example": "pnpm build && node dist/examples/demo.js",
    "evaluate": "pnpm build && node dist/evals/harness/evaluate.js",
    "evaluate:replay": "pnpm build && node dist/evals/harness/replay.js",
    "eval:loop": "pnpm build && node dist/evals/loop.js",
    "eval:replay": "pnpm build && node dist/evals/replay.js",
    "runtime:build": "cargo build --release --manifest-path evals/rust-probe/Cargo.toml && cargo build --release --lib --target wasm32-unknown-unknown --manifest-path evals/rust-probe/Cargo.toml",
    "runtime:test": "pnpm build && cargo test --manifest-path evals/rust-probe/Cargo.toml && node --test dist/evals/runtime/rust-test.js dist/evals/runtime/system-test.js",
    "runtime:browser": "playwright test --config runtime-playwright.config.ts",
    "runtime:eval": "pnpm build && node dist/evals/runtime/evaluate.js",
    "eval:shard": "pnpm build && node dist/evals/runtime/shard-cli.js"
  },
  "dependencies": {
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "tla-ts": "0.0.10",
    "z3-solver": "5.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@mizchi/mutator": "0.2.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
